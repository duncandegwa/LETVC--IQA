// Laikipia East TVC — IQA Management System
// PostgreSQL schema (Prisma)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum SystemRole {
  ADMIN
  STAFF // every non-admin account; capabilities below determine what they can do
}

// A user's functional capability within a department. A single user can hold
// several of these across one or more departments — this is what makes
// "HODs and IQA Officers are also Trainers" work: Trainer is implicit for
// every STAFF user, while HOD / IQA_OFFICER / DP_ACADEMICS are additive
// department assignments layered on top.
enum DeptRole {
  HOD
  IQA_OFFICER
  DP_ACADEMICS
}

enum DocumentType {
  LEARNING_PLAN
  SESSION_PLAN
  RECORD_OF_WORK
  WORK_LOAD
  TIMETABLE
}

enum DocumentStatus {
  DRAFT
  PENDING_HOD_REVIEW
  RETURNED_BY_HOD
  PENDING_IQA_REVIEW
  RETURNED_BY_IQA
  PENDING_DP_VERIFICATION
  RETURNED_BY_DP
  APPROVED
  ARCHIVED
  NEEDS_ADMIN_ASSIGNMENT // no eligible non-conflicted reviewer was found automatically
}

enum ReviewStage {
  HOD_REVIEW
  IQA_REVIEW
  DP_VERIFICATION
}

enum ReviewDecision {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

enum NotificationType {
  DOCUMENT_SUBMITTED
  RETURNED
  APPROVED_BY_HOD
  APPROVED_BY_IQA
  VERIFIED_BY_DP
  REVIEWER_ASSIGNED
  REVIEW_COMPLETED
  DEADLINE_REMINDER
  ACCOUNT_CREATED
  PASSWORD_RESET
  BROADCAST
  NEW_MESSAGE
}

// ---------------------------------------------------------------------------
// CORE
// ---------------------------------------------------------------------------

model User {
  id                String       @id @default(uuid())
  // Firebase Authentication owns identity/credentials; this is the link
  // between a Firebase Auth user and their profile + role assignments here.
  // Nothing in this schema stores or hashes a password anymore.
  firebaseUid       String       @unique
  fullName          String
  staffNumber       String       @unique
  email             String       @unique
  phone             String?
  designation       String?
  profilePhotoUrl   String?
  // Firebase has no built-in "force password change" concept, so we track it
  // here and the frontend enforces it after a Firebase sign-in.
  mustChangePassword Boolean     @default(true)
  systemRole        SystemRole   @default(STAFF)
  isActive          Boolean      @default(true)
  primaryDepartmentId String?
  primaryDepartment Department? @relation("PrimaryDeptUsers", fields: [primaryDepartmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  deptAssignments      DepartmentAssignment[] @relation("AssignmentUser")
  uploadedDocuments    Document[]              @relation("Uploader")
  reviewAssignments    ReviewAssignment[]      @relation("Assignee")
  signatureAssets      SignatureAsset[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  messages             Message[]
  reviewerAssignmentAsTrainer TrainerReviewerAssignment? @relation("TrainerLink")
  reviewerAssignmentsAsHod    TrainerReviewerAssignment[] @relation("HodLink")
  reviewerAssignmentsAsIqa    TrainerReviewerAssignment[] @relation("IqaLink")

  @@index([email])
  @@index([firebaseUid])
}

// Explicit Administrator-assigned mapping of a Trainer to the specific HOD
// and IQA Officer who review their documents ("Reviewer Assignment:
// Administrator assigns Trainer -> HOD, Trainer -> IQA" per spec). When set,
// reviewerAssignment.js uses this directly instead of picking from the
// department-wide capability pool. DP verification stays department-scoped
// (the spec only calls for Department -> DP Academics, not a per-trainer
// link), so there's no dpId here.
model TrainerReviewerAssignment {
  id        String   @id @default(uuid())
  trainerId String   @unique
  hodId     String?
  iqaId     String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  trainer User  @relation("TrainerLink", fields: [trainerId], references: [id])
  hod     User? @relation("HodLink", fields: [hodId], references: [id])
  iqa     User? @relation("IqaLink", fields: [iqaId], references: [id])
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())

  primaryUsers  User[]                 @relation("PrimaryDeptUsers")
  assignments   DepartmentAssignment[]
  documents     Document[]
}

// Who acts as HOD / IQA Officer / DP for which department. `isActing` marks
// a delegated/alternate reviewer configured by the Administrator — this is
// the fallback pool used when the "natural" reviewer has a conflict of
// interest with a specific document (see services/reviewerAssignment.js).
model DepartmentAssignment {
  id           String     @id @default(uuid())
  userId       String
  departmentId String
  role         DeptRole
  isActing     Boolean    @default(false) // true = designated alternate/acting reviewer
  startDate    DateTime   @default(now())
  endDate      DateTime?  // null = open-ended

  user       User       @relation("AssignmentUser", fields: [userId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@index([departmentId, role])
  @@unique([userId, departmentId, role, isActing])
}

model Document {
  id             String         @id @default(uuid())
  type           DocumentType
  title          String
  academicYear   String
  semester       String
  departmentId   String
  uploaderId     String
  status         DocumentStatus @default(DRAFT)
  currentVersionNo Int          @default(1)
  verificationNumber String?     @unique // set on final approval, used by QR page
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  department Department        @relation(fields: [departmentId], references: [id])
  uploader   User              @relation("Uploader", fields: [uploaderId], references: [id])
  versions   DocumentVersion[]
  reviews    ReviewAssignment[]
  auditLogs  AuditLog[]
  messages   Message[]

  @@index([departmentId, status])
  @@index([uploaderId])
}

// A per-document discussion thread. Doubles as both "reply to a reviewer's
// comment" and general trainer<->reviewer chat — both are just messages in
// the same thread, ordered by time. Access is governed by the same
// documentController.js::userCanAccessDocument check used for
// preview/download, so only legitimate stakeholders for that document
// (the uploader, anyone ever assigned to review it, the department's
// review-chain roles, and Administrators) can read or post.
model Message {
  id         String   @id @default(uuid())
  documentId String
  senderId   String
  body       String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id])
  sender   User     @relation(fields: [senderId], references: [id])

  @@index([documentId, createdAt])
}

model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String
  versionNo  Int
  fileUrl    String
  fileHash   String   // sha256 of stored file, for integrity/audit
  uploadedAt DateTime @default(now())
  isFinal    Boolean  @default(false) // true = the fully-stamped approved PDF

  document Document @relation(fields: [documentId], references: [id])

  @@unique([documentId, versionNo])
}

// One row per stage per document. The assignee is resolved by
// services/reviewerAssignment.js and is guaranteed never to equal
// Document.uploaderId (see ARCHITECTURE.md §4).
model ReviewAssignment {
  id          String         @id @default(uuid())
  documentId  String
  stage       ReviewStage
  assigneeId  String?        // nullable only while status = NEEDS_ADMIN_ASSIGNMENT
  decision    ReviewDecision @default(PENDING)
  comment     String?
  decidedAt   DateTime?
  assignedAt  DateTime       @default(now())
  wasReassignedForConflict Boolean @default(false)

  document Document @relation(fields: [documentId], references: [id])
  assignee User?     @relation("Assignee", fields: [assigneeId], references: [id])

  @@index([documentId, stage])
  @@index([assigneeId, decision])
}

model SignatureAsset {
  id        String   @id @default(uuid())
  userId    String
  kind      String   // "SIGNATURE" | "STAMP"
  fileUrl   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// Append-only. Every state-changing action writes exactly one row via
// services/auditLog.js::logAudit().
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  documentId String?
  action     String   // e.g. "DOCUMENT_UPLOADED", "HOD_APPROVED", "REVIEWER_REASSIGNED_CONFLICT"
  metadata   Json?
  createdAt  DateTime @default(now())

  actor    User?     @relation(fields: [actorId], references: [id])
  document Document? @relation(fields: [documentId], references: [id])

  @@index([documentId])
  @@index([actorId])
}

model Notification {
  id        String            @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  isRead    Boolean           @default(false)
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}


